                android:padding="4dp">
                <ImageView
                    android:id="@+id/img6"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/name6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
